#!/usr/bin/env bash
# Builds a self-contained DataDip.app (bundling Swift WKWebView shell, compiled Bun server + worker,
# Vite web client, and SSH askpass helper) and packages it into a signed (and optionally notarized) .dmg.
set -euo pipefail

mac="$(cd "$(dirname "$0")" && pwd)"
repo="$(dirname "$mac")"
out_dir="$repo/build"
bundle_id="dev.datadip.app"
sign_identity=""
no_sign=""
notary_profile="${DATADIP_NOTARY_PROFILE:-}"

while [ $# -gt 0 ]; do
	case "$1" in
		--sign) sign_identity="$2"; shift 2 ;;
		--no-sign) no_sign=1; shift ;;
		--notarize) notary_profile="$2"; shift 2 ;;
		--bundle-id) bundle_id="$2"; shift 2 ;;
		--out) out_dir="$2"; shift 2 ;;
		-h|--help)
			cat <<'USAGE'
Usage: mac/build-dmg [options]
  --sign <identity>      Codesign identity (default: auto-detect Developer ID Application, else ad-hoc)
  --no-sign              Force ad-hoc signing (-)
  --notarize <profile>   Submit .dmg to Apple notarytool using this Keychain profile and staple
  --bundle-id <id>       CFBundleIdentifier (default: dev.datadip.app)
  --out <dir>            Output directory (default: ./build)
USAGE
			exit 0
			;;
		*) echo "Unknown option: $1" >&2; exit 1 ;;
	esac
done

command -v swiftc >/dev/null || { echo "swiftc is missing: run xcode-select --install" >&2; exit 1; }
command -v hdiutil >/dev/null || { echo "hdiutil is missing" >&2; exit 1; }
bun="$(command -v bun || echo "$HOME/.bun/bin/bun")"
[ -x "$bun" ] || { echo "bun is missing" >&2; exit 1; }

version="$("$bun" -e "console.log(require('$repo/package.json').version)")"
arch="$(uname -m)"

# Auto-detect Developer ID Application identity if not explicitly specified
if [ -n "$no_sign" ]; then
	sign_identity="-"
elif [ -z "$sign_identity" ]; then
	sign_identity="$(security find-identity -v -p codesigning 2>/dev/null \
		| sed -n 's/.*"\(Developer ID Application: [^"]*\)".*/\1/p' \
		| head -n 1 || true)"
	if [ -z "$sign_identity" ]; then
		echo "Note: no 'Developer ID Application' identity found; falling back to ad-hoc signing (-)."
		sign_identity="-"
	fi
fi

echo "==> Building DataDip $version ($arch)"
echo "    Bundle ID: $bundle_id"
echo "    Signing:   $sign_identity"
[ -n "$notary_profile" ] && echo "    Notarize:  profile '$notary_profile'"

echo "==> Building web client (Vite)"
(cd "$repo" && "$bun" run build)

tmp="$(mktemp -d "${TMPDIR:-/tmp}/datadip-dmg.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

app="$tmp/DataDip.app"
contents="$app/Contents"
mkdir -p "$contents/MacOS" "$contents/Resources"

echo "==> Compiling standalone Bun server + SQLite worker"
(cd "$repo" && "$bun" build --compile server/index.ts server/db/sqlite-query-worker.ts \
	--outfile "$contents/MacOS/datadip-server")

echo "==> Compiling native macOS shell (swiftc)"
swiftc -O -o "$contents/MacOS/DataDip" "$mac/DataDip.swift"

echo "==> Copying web assets & SSH askpass helper"
cp -R "$repo/dist" "$contents/Resources/dist"
cp "$repo/server/db/ssh-askpass.sh" "$contents/Resources/ssh-askpass.sh"
chmod +x "$contents/Resources/ssh-askpass.sh"

icon_src="$repo/public/icon-1024.png"
if [ -f "$icon_src" ] && command -v sips >/dev/null && command -v iconutil >/dev/null; then
	echo "==> Generating AppIcon.icns"
	iconset="$tmp/AppIcon.iconset"
	mkdir -p "$iconset"
	for s in 16 32 128 256 512; do
		sips -z "$s" "$s" "$icon_src" --out "$iconset/icon_${s}x${s}.png" >/dev/null
		s2=$((s * 2))
		sips -z "$s2" "$s2" "$icon_src" --out "$iconset/icon_${s}x${s}@2x.png" >/dev/null
	done
	iconutil -c icns "$iconset" -o "$contents/Resources/AppIcon.icns"
fi

cat > "$contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
	<key>CFBundleName</key><string>DataDip</string>
	<key>CFBundleDisplayName</key><string>DataDip</string>
	<key>CFBundleIdentifier</key><string>$bundle_id</string>
	<key>CFBundleExecutable</key><string>DataDip</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$version</string>
	<key>CFBundleVersion</key><string>$version</string>
	<key>LSMinimumSystemVersion</key><string>13.3</string>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSAppTransportSecurity</key><dict>
		<key>NSAllowsLocalNetworking</key><true/>
	</dict>
	<key>CFBundleDocumentTypes</key><array>
		<dict>
			<key>CFBundleTypeName</key><string>SQLite Database</string>
			<key>CFBundleTypeRole</key><string>Editor</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>CFBundleTypeExtensions</key><array>
				<string>db</string>
				<string>sqlite</string>
				<string>sqlite3</string>
				<string>db3</string>
			</array>
		</dict>
	</array>
</dict></plist>
EOF

echo "==> Signing DataDip.app"
if [ "$sign_identity" = "-" ]; then
	codesign --force --sign - "$contents/MacOS/datadip-server"
	codesign --force --sign - "$app"
else
	# Sign inside-out with Hardened Runtime + Bun JIT entitlements for notarization
	codesign --force --timestamp --options runtime \
		--entitlements "$mac/entitlements.plist" \
		--sign "$sign_identity" \
		"$contents/MacOS/datadip-server"
	codesign --force --timestamp --options runtime \
		--sign "$sign_identity" \
		"$app"
fi

echo "==> Verifying app signature"
codesign --verify --deep --strict --verbose=2 "$app"

mkdir -p "$out_dir"
rm -rf "$out_dir/DataDip.app"
cp -R "$app" "$out_dir/DataDip.app"

dmg_stage="$tmp/dmg-stage"
mkdir -p "$dmg_stage/.background"
cp -R "$app" "$dmg_stage/DataDip.app"
ln -s /Applications "$dmg_stage/Applications"

# Render 1x + 2x Retina DMG background artwork and combine into a HiDPI TIFF for Finder
dmg_bg_tiff=""
if [ -f "$mac/render-dmg-bg.swift" ] && command -v swift >/dev/null && command -v tiffutil >/dev/null; then
	echo "==> Rendering Retina DMG background"
	swift "$mac/render-dmg-bg.swift" "$tmp/bg-1x.png" "$tmp/bg-2x.png" "v$version"
	tiffutil -cathidpicheck "$tmp/bg-1x.png" "$tmp/bg-2x.png" -out "$dmg_stage/.background/background.tiff" >/dev/null
	dmg_bg_tiff=".background:background.tiff"
fi

# Custom volume icon matching DataDip.app
if [ -f "$contents/Resources/AppIcon.icns" ]; then
	cp "$contents/Resources/AppIcon.icns" "$dmg_stage/.VolumeIcon.icns"
fi

dmg="$out_dir/DataDip-${version}-${arch}.dmg"
rm -f "$dmg"

rw_dmg="$tmp/DataDip-rw.dmg"
vol_name="DataDip"

# Detach any existing mounted DataDip volume to avoid name collisions ("DataDip 1")
if [ -d "/Volumes/$vol_name" ]; then
	hdiutil detach "/Volumes/$vol_name" -force >/dev/null 2>&1 || true
fi

echo "==> Creating styled DMG layout"
hdiutil create -volname "$vol_name" -srcfolder "$dmg_stage" -fs HFS+ -fsargs "-c c=64,a=16,e=16" \
	-format UDRW -ov "$rw_dmg" >/dev/null

# Attach read-write and configure Finder window geometry, icon positions, background, and volume icon
attach_out="$(hdiutil attach -readwrite -noverify -noautoopen "$rw_dmg")"
dmg_dev="$(echo "$attach_out" | awk '/\/Volumes\// {print $1; exit}')"
dmg_mnt="$(echo "$attach_out" | sed -n 's/.*\(\/Volumes\/.*\)$/\1/p' | head -n 1)"

if [ -n "$dmg_mnt" ] && [ -d "$dmg_mnt" ]; then
	if command -v SetFile >/dev/null; then
		[ -f "$dmg_mnt/.VolumeIcon.icns" ] && SetFile -a C "$dmg_mnt" || true
		[ -d "$dmg_mnt/.background" ] && SetFile -a V "$dmg_mnt/.background" || true
	fi

	# Ensure Finder writes .DS_Store with exact window bounds (640x400 content + 28pt titlebar) and icon placement
	if command -v osascript >/dev/null && [ -n "$dmg_bg_tiff" ]; then
		vol_base="$(basename "$dmg_mnt")"
		osascript <<APPLESCRIPT || true
tell application "Finder"
	tell disk "$vol_base"
		open
		set current view of container window to icon view
		set toolbar visible of container window to false
		set statusbar visible of container window to false
		set bounds of container window to {200, 140, 840, 568}
		set viewOptions to the icon view options of container window
		set arrangement of viewOptions to not arranged
		set icon size of viewOptions to 128
		set text size of viewOptions to 13
		set background picture of viewOptions to file "$dmg_bg_tiff"
		set position of item "DataDip.app" of container window to {175, 180}
		set position of item "Applications" of container window to {465, 180}
		update without registering applications
		delay 2
		close
		open
		delay 1
		close
	end tell
end tell
APPLESCRIPT
	fi

	# Prevent Finder from writing fsevents logs into the read-only image and flush .DS_Store
	rm -rf "$dmg_mnt/.fseventsd" "$dmg_mnt/.Trashes" 2>/dev/null || true
	chmod -Rf go-w "$dmg_mnt" 2>/dev/null || true
	sync
	sleep 1
	hdiutil detach "$dmg_dev" >/dev/null || hdiutil detach "$dmg_dev" -force >/dev/null
fi

echo "==> Compressing final DMG: $dmg"
hdiutil convert "$rw_dmg" -format UDZO -imagekey zlib-level=9 -ov -o "$dmg" >/dev/null

if [ "$sign_identity" != "-" ]; then
	echo "==> Signing DMG"
	codesign --force --timestamp --sign "$sign_identity" "$dmg"
	codesign --verify --verbose=2 "$dmg"
fi

if [ -n "$notary_profile" ]; then
	if [ "$sign_identity" = "-" ]; then
		echo "Error: cannot notarize an ad-hoc signed DMG; install a Developer ID Application certificate." >&2
		exit 1
	fi
	echo "==> Submitting DMG for Apple notarization (profile: $notary_profile)..."
	xcrun notarytool submit "$dmg" --keychain-profile "$notary_profile" --wait
	echo "==> Stapling notarization ticket to DMG"
	xcrun stapler staple "$dmg"
	echo "==> Verifying Gatekeeper assessment"
	spctl --assess --type open --context context:primary-signature -vv "$dmg"
fi

echo ""
echo "Done:"
ls -lh "$dmg"
echo "App bundle: $out_dir/DataDip.app"
